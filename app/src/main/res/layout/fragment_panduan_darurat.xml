<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_red"
    tools:context=".PanduanDaruratFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panduan Keselamatan"
            android:textColor="@color/dark_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Langkah awal pertolongan pertama saat keadaan darurat."
            android:textColor="#8A7370"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FDE3E0"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Tetap tenang dan pastikan area sekitar aman."
                    android:textColor="@color/dark_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="2. Kirim laporan lewat SIAGA atau tekan tombol SOS."
                    android:textColor="@color/dark_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="3. Ikuti arahan petugas sampai bantuan tiba."
                    android:textColor="@color/dark_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nomor darurat"
            android:textColor="@color/dark_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- DIUBAH: empat baris menu lama diganti GridLayout 3 kolom x 2 baris.
             columnCount = jumlah kolom; useDefaultMargins = jarak antar tombol otomatis -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridNomor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:columnCount="3"
            app:useDefaultMargins="true">

            <!-- layout_columnWeight="1" + layout_gravity="fill_horizontal" membuat
                 semua tombol sama lebar dan mengisi kolomnya.
                 iconGravity="top" menaruh ikon di atas teks -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAmbulans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/emergency_red"
                android:text="Ambulans\n119"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_heart"
                app:iconGravity="top"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPemadam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/emergency_red"
                android:text="Pemadam\n113"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_fire"
                app:iconGravity="top"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPolisi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/emergency_red"
                android:text="Polisi\n110"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_shield"
                app:iconGravity="top"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBasarnas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/deep_red"
                android:text="Basarnas\n115"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_location"
                app:iconGravity="top"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUmum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/deep_red"
                android:text="Darurat Umum\n112"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_phone"
                app:iconGravity="top"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPln"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/deep_red"
                android:text="PLN\n123"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_warning"
                app:iconGravity="top"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />
        </androidx.gridlayout.widget.GridLayout>
    </LinearLayout>
</ScrollView>